<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/appBar"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:title="语音电话助手"
            app:titleTextColor="@color/appBarText" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="28dp">

            <!-- 状态卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SettingGroup"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginRight="8dp"
                            android:background="@drawable/bg_dot" />

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="服务状态：已停止"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="通话状态：空闲"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStartStop"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/primary"
                        android:text="启动服务"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 权限与开关 -->
            <TextView
                style="@style/SectionHeader"
                android:text="权限与开关" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingGroup">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="必开权限" />

                            <TextView
                                android:id="@+id/tvPermissions"
                                style="@style/RowSubtitle"
                                android:text="正在检查权限..." />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnPermissions"
                            style="@style/RowAction"
                            android:text="检查" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="无障碍服务" />

                            <TextView
                                android:id="@+id/tvA11yStatus"
                                style="@style/RowSubtitle"
                                android:text="未开启" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnAccessibility"
                            style="@style/RowAction"
                            android:text="去开启" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="通知使用权" />

                            <TextView
                                android:id="@+id/tvNotifStatus"
                                style="@style/RowSubtitle"
                                android:text="未开启（拿不到姓名和通知按钮）" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnNotificationAccess"
                            style="@style/RowAction"
                            android:text="去开启" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="来电识别（筛选角色）" />

                            <TextView
                                android:id="@+id/tvScreeningStatus"
                                style="@style/RowSubtitle"
                                android:text="未开启" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnCallScreening"
                            style="@style/RowAction"
                            android:text="去开启" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout
                        style="@style/SettingRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="最近来电通知" />

                        <TextView
                            android:id="@+id/tvLastNotif"
                            style="@style/RowSubtitle"
                            android:text="暂无" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 识别模型 -->
            <TextView
                style="@style/SectionHeader"
                android:text="识别模型" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingGroup">

                <LinearLayout style="@style/SettingRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="当前模型" />

                        <TextView
                            android:id="@+id/tvModelStatus"
                            style="@style/RowSubtitle"
                            android:text="标准模型（内置 66MB）" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAsrModel"
                        style="@style/RowAction"
                        android:text="切换" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 声音 -->
            <TextView
                style="@style/SectionHeader"
                android:text="声音" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingGroup">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="播报音量" />

                        <TextView
                            android:id="@+id/tvAudioStatus"
                            style="@style/RowSubtitle"
                            android:text="跟随系统媒体音量，静音时不播报" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="扬声器外放" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="开着蓝牙/耳机时也用手机喇叭播报" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swSpeaker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/SettingRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RowTitle"
                                android:text="试听一句" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="需先启动服务" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnTestSpeak"
                            style="@style/RowAction"
                            android:text="试听" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 语音指令 -->
            <TextView
                style="@style/SectionHeader"
                android:text="语音指令" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingGroup">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="问时间口令"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTimeCommand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="接听口令"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAnswerCommand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="挂断口令"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHangupCommand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/cbAnnounceCaller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="来电时播报姓名"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnSaveSettings"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/primary"
                        android:text="保存指令"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/tvSettingsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="默认：几点了 / 接电话 / 挂断电话，改完立即生效。"
                        android:textColor="@color/textTertiary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 实时日志 -->
            <TextView
                style="@style/SectionHeader"
                android:text="实时日志" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingGroup">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="最近的识别与来电记录"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnCopyLog"
                            style="@style/RowAction"
                            android:text="复制日志" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_log"
                        android:padding="12dp"
                        android:scrollbars="vertical">

                        <TextView
                            android:id="@+id/tvDebug"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2dp"
                            android:text="等待服务启动..."
                            android:textColor="@color/logText"
                            android:textSize="12sp" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="v2.6 · github.com/haoliying/VoiceCallAssistant"
                android:textColor="@color/textTertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
